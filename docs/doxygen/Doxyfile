# Doxygen configuration for the SparQ C++ API — generates XML for Sphinx/Breathe to render into the documentation site.
# Usage: cd docs/doxygen && doxygen Doxyfile
# (The html target of docs/sphinx/Makefile runs this configuration automatically)
# All relative paths are relative to docs/doxygen/.

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "SparQ"
PROJECT_BRIEF          = "Sparse-state quantum circuit simulator (register-level programming, native QRAM, algorithm library)"

# Output goes to docs/doxygen/build/ (already ignored by the build*/ rule in .gitignore)
OUTPUT_DIRECTORY       = build
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml

INPUT_ENCODING         = UTF-8
INPUT                  = ../../SparQ/include \
                         ../../SparQ_Algorithm/include \
                         ../../PySparQ/include \
                         ../../PySparQ/pysparq/dynamic_operator/include
FILE_PATTERNS          = *.h \
                         *.hpp \
                         *.cuh
RECURSIVE              = YES

# QRAM base and Eigen headers included by the header files: used only for type resolution, not included in the documentation
INCLUDE_PATH           = ../../extern/qram-simulator/Common/include \
                         ../../extern/qram-simulator/QRAM/include \
                         ../../extern/qram-simulator/ThirdParty/eigen-3.4.0
EXCLUDE_PATTERNS       = */extern/*

# Render only documented entities (the source headers have been supplemented with complete Chinese Doxygen comments)
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
CASE_SENSE_NAMES       = NO

# Macros such as ClassControllable are defined in global_macros.h and expanded by the default preprocessing
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = NO
WARN_NO_PARAMDOC       = NO

SHOW_FILES             = YES
SHOW_NAMESPACES        = YES
