# SparQ C++ API 的 Doxygen 配置 —— 生成 XML 供 Sphinx/Breathe 渲染进文档站。
# 用法：cd docs/doxygen && doxygen Doxyfile
# （docs/sphinx/Makefile 的 html 目标会自动执行本配置）
# 所有相对路径均以 docs/doxygen/ 为基准。

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "SparQ"
PROJECT_BRIEF          = "稀疏态量子电路模拟器（寄存器级编程、原生 QRAM、算法库）"

# 输出到 docs/doxygen/build/（已被 .gitignore 的 build*/ 规则忽略）
OUTPUT_DIRECTORY       = build
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml

INPUT_ENCODING         = UTF-8
INPUT                  = ../../SparQ/include \
                         ../../SparQ_Algorithm/include \
                         ../../PySparQ/include \
                         ../../PySparQ/pysparq/dynamic_operator/include
FILE_PATTERNS          = *.h \
                         *.hpp \
                         *.cuh
RECURSIVE              = YES

# 头文件 include 的 QRAM 基座与 Eigen 头：仅用于类型解析，不纳入文档
INCLUDE_PATH           = ../../extern/qram-simulator/Common/include \
                         ../../extern/qram-simulator/QRAM/include \
                         ../../extern/qram-simulator/ThirdParty/eigen-3.4.0
EXCLUDE_PATTERNS       = */extern/*

# 只渲染带注释的实体（源码头文件已补齐中文 Doxygen 注释）
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
CASE_SENSE_NAMES       = NO

# ClassControllable 等宏定义于 global_macros.h，由默认预处理展开
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = NO
WARN_NO_PARAMDOC       = NO

SHOW_FILES             = YES
SHOW_NAMESPACES        = YES
